<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textViewReportIncidentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report an Incident"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/textViewDescriptionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Describe the issue"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/editTextDescription"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top|start"
            android:hint="What happened?"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="textMultiLine"
            android:background="@drawable/input_background"
            android:padding="16dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/textViewScreenshotLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screenshot"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/imageViewScreenshot"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:contentDescription="Selected screenshot"
            android:scaleType="centerInside"
            android:background="@color/surface"
            android:src="@android:drawable/ic_menu_gallery"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonSelectScreenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Screenshot"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:background="@drawable/button_background"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonSubmitIncident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Incident"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:background="@drawable/button_background" />

    </LinearLayout>

</ScrollView>