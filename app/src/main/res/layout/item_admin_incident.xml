<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="18dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/textViewAdminIncidentId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INC-XXXXXX"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textViewAdminIncidentDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Incident description"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/imageViewAdminIncidentScreenshot"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerInside"
        android:contentDescription="Incident screenshot" />

    <TextView
        android:id="@+id/textViewAdminIncidentStatusLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinnerIncidentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/buttonUpdateIncidentStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Status"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:background="@drawable/button_background" />

</LinearLayout>